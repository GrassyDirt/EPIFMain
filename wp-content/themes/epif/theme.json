{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"palette": [
				{
					"color": "#F5F0E6",
					"name": "Paper",
					"slug": "base"
				},
				{
					"color": "#1E1D1A",
					"name": "Ink",
					"slug": "contrast"
				},
				{
					"color": "#FBF8F2",
					"name": "Paper light",
					"slug": "accent-1"
				},
				{
					"color": "#DCD3C3",
					"name": "Line",
					"slug": "accent-2"
				},
				{
					"color": "#1F63B0",
					"name": "EPIF blue",
					"slug": "accent-3"
				},
				{
					"color": "#57524A",
					"name": "Muted",
					"slug": "accent-4"
				},
				{
					"color": "#FFFFFF",
					"name": "White",
					"slug": "accent-5"
				},
				{
					"color": "#3E7A1F",
					"name": "EPIF green",
					"slug": "accent-6"
				},
				{
					"color": "#123A66",
					"name": "Navy",
					"slug": "navy"
				}
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"typography": {
			"fontFamilies": [
				{
					"name": "Archivo",
					"slug": "display",
					"fontFamily": "Archivo, \"Arial Narrow\", sans-serif"
				},
				{
					"name": "Public Sans",
					"slug": "body",
					"fontFamily": "\"Public Sans\", system-ui, sans-serif"
				}
			]
		}
	},
	"styles": {
		"elements": {
			"button": {
				"color": {
					"background": "var:preset|color|accent-3",
					"text": "var:preset|color|base"
				},
				"border": {
					"radius": "10px"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|contrast",
						"text": "var:preset|color|base"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontWeight": "800"
				}
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body"
		},
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		}
	},
	"customTemplates": [
		{
			"name": "page-landing",
			"title": "Landing Page",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-about",
			"title": "About Us",
			"postTypes": [
				"page"
			]
		}
	]
}