{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"palette": [
				{ "color": "#FFFFFF", "name": "Base", "slug": "base" },
				{ "color": "#342E37", "name": "Contrast (EPIF ink)", "slug": "contrast" },
				{ "color": "#FAF8F4", "name": "Accent 1 (EPIF paper)", "slug": "accent-1" },
				{ "color": "#E6E1D9", "name": "Accent 2 (EPIF line)", "slug": "accent-2" },
				{ "color": "#2B72BC", "name": "Accent 3 (EPIF blue)", "slug": "accent-3" },
				{ "color": "#6B6670", "name": "Accent 4 (EPIF soft ink)", "slug": "accent-4" },
				{ "color": "#FFFFFF", "name": "Accent 5", "slug": "accent-5" },
				{ "color": "#342E3733", "name": "Accent 6", "slug": "accent-6" },
				{ "color": "#FA824C", "name": "EPIF orange (auctions)", "slug": "epif-orange" },
				{ "color": "#9FD356", "name": "EPIF green (tokens, impact)", "slug": "epif-green" }
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		}
	},
	"styles": {
		"elements": {
			"button": {
				"color": { "background": "var:preset|color|accent-3", "text": "var:preset|color|base" },
				"border": { "radius": "6px" },
				":hover": {
					"color": { "background": "var:preset|color|contrast", "text": "var:preset|color|base" }
				}
			}
		}
	},
	"customTemplates": [
		{
			"name": "page-landing",
			"title": "Landing Page",
			"postTypes": [ "page" ]
		},
		{
			"name": "page-early-access",
			"title": "Early Access (digital mall)",
			"postTypes": [ "page" ]
		}
	]
}
